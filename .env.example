# Obtain from @BotFather. Never put this in a VITE_ variable.
BOT_TOKEN=
# Public HTTPS URL of this application, without a path.
APP_URL=https://miniapp.example.com
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
# Set true only behind the documented local Caddy reverse proxy.
TRUST_PROXY=false
# false permits frontend/health development without Telegram credentials.
BOT_ENABLED=true
